      "v": "00"
    }
  },
  {
    "id": "if-string-space",
    "tmpl": "<TMPL_IF v>T<TMPL_ELSE>F</TMPL_IF>",
    "params": {
      "v": " "
    }
  },
  {
    "id": "if-numeric-zero",
    "tmpl": "<TMPL_IF v>T<TMPL_ELSE>F</TMPL_IF>",
    "params": {
      "v": 0
    }
  },
  {
    "id": "if-unset",
    "tmpl": "<TMPL_IF v>T<TMPL_ELSE>F</TMPL_IF>",
    "params": {},
    "opts": {
      "die_on_bad_params": 0
    }
  },
  {
    "id": "unless-else",
    "tmpl": "<TMPL_UNLESS v>T<TMPL_ELSE>F</TMPL_UNLESS>",
    "params": {
      "v": ""
    }
  },
  {
    "id": "nested-if-else",
    "tmpl": "<TMPL_IF a>A<TMPL_ELSE><TMPL_IF b>B<TMPL_ELSE>C</TMPL_IF></TMPL_IF>",
    "params": {
      "a": 0,
      "b": 0
    }
  },
  {
    "id": "global-vars-outer-visible",
    "tmpl": "<TMPL_LOOP L>[<TMPL_VAR outer>]</TMPL_LOOP>",
    "params": {
      "L": [{}, {}],
      "outer": "OUT"
    },
    "opts": {
      "global_vars": 1
    }
  },
  {
    "id": "global-vars-inner-shadows",
    "tmpl": "<TMPL_LOOP L>[<TMPL_VAR v>]</TMPL_LOOP>",
    "params": {
      "L": [
        {
          "v": "IN"
        },
        {}
      ],
      "v": "OUT"
    },
    "opts": {
      "global_vars": 1
    }
  },
  {
    "id": "global-vars-in-conditional",
    "tmpl": "<TMPL_LOOP L><TMPL_IF g>G<TMPL_ELSE>-</TMPL_IF></TMPL_LOOP>",
    "params": {
      "L": [{}, {}],
      "g": 1
    },
    "opts": {
      "global_vars": 1
    }
  },
  {
    "id": "global-vars-two-levels",
    "tmpl": "<TMPL_LOOP A><TMPL_LOOP B>[<TMPL_VAR top>|<TMPL_VAR mid>]</TMPL_LOOP></TMPL_LOOP>",
    "params": {
      "top": "T",
      "A": [
        {
          "mid": "M",
          "B": [{}, {}]
        }
      ]
    },
    "opts": {
      "global_vars": 1
    }
  },
  {
    "id": "no-global-vars-outer-hidden",
    "tmpl": "<TMPL_LOOP L>[<TMPL_VAR v>]</TMPL_LOOP>",
    "params": {
      "L": [
        {
          "v": "IN"
        },
        {
          "v": null
        }
      ]
    }
  },
  {
    "id": "case-insensitive-lookup",
    "tmpl": "<TMPL_VAR NAME=FooBar>",
    "params": {
      "foobar": "v"
    }
  },
  {
    "id": "case-sensitive-lookup",
    "tmpl": "[<TMPL_VAR NAME=FooBar>][<TMPL_VAR NAME=foobar>]",
    "params": {
