    "params": {
      "L": [{}, {}]
    },
    "opts": {
      "die_on_bad_params": 0
    },
    "associate": {
      "fromcgi": "CGI"
    }
  },
  {
    "id": "filter-rewrites-source",
    "tmpl": "XXvXX",
    "params": {
      "v": "V"
    },
    "filter": "xx-to-tag"
  },
  {
    "id": "query-top-level-names",
