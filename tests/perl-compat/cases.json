      "foobar": "B"
    },
    "opts": {
      "case_sensitive": 1
    }
  },
  {
    "id": "vanguard-plain",
    "tmpl": "x %foo% y",
    "params": {
      "foo": "A"
    },
    "opts": {
      "vanguard_compatibility_mode": 1
    }
  },
  {
    "id": "vanguard-punctuated-names",
    "note": "Perl's vanguard pattern is %([-\\w/.+]+)%, not %(\\w+)%",
    "tmpl": "x %foo.bar% y %baz-qux% z %a/b% w",
    "params": {
      "foo.bar": "A",
      "baz-qux": "B",
      "a/b": "C"
    },
    "opts": {
      "vanguard_compatibility_mode": 1
    }
  },
  {
    "id": "associate-fills-top-level",
    "tmpl": "[<TMPL_VAR a>][<TMPL_VAR b>]",
    "params": {
      "b": "SET"
    },
