  {
    "id": "query-name-loop-scoped-without-path",
    "tmpl": "<TMPL_LOOP L><TMPL_VAR a></TMPL_LOOP>",
    "params": {},
    "opts": {
      "die_on_bad_params": 0
    },
    "queryname": ["a"]
  },
  {
    "id": "set-loop-scoped-name-dies",
    "note": "Each loop body is its own namespace, so this is a bad param at the top level",
    "tmpl": "<TMPL_LOOP L><TMPL_VAR inner></TMPL_LOOP>",
    "params": {
      "inner": "TOP"
    }
  },
  {
    "id": "set-conditional-scoped-name-ok",
    "tmpl": "<TMPL_IF c>[<TMPL_VAR inside_if>]</TMPL_IF>",
    "params": {
      "c": 1,
      "inside_if": "V"
    }
  },
  {
    "id": "get-nonexistent-param-dies",
    "tmpl": "<TMPL_VAR a>",
    "params": {},
    "get": "nope"
  },
  {
    "id": "clear-params-resets",
