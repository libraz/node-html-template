    }
  },
  {
    "id": "loop-data-undeclared-key-dies",
    "note": "Perl applies die_on_bad_params to each loop iteration hash",
    "tmpl": "<TMPL_LOOP L><TMPL_IF __first__>F</TMPL_IF></TMPL_LOOP>",
    "params": {
      "L": [
        {
          "stray": 1
        }
      ]
    },
    "opts": {
      "loop_context_vars": 1
    }
  },
  {
    "id": "loop-data-undeclared-key-tolerated",
