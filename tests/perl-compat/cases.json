[
  {
    "id": "bare-name-only",
    "note": "A lone word is the NAME, so <tmpl_var name> declares a variable called 'name'",
    "tmpl": "Hello <tmpl_var name> friend",
    "params": {
      "name": "Fred"
    }
  },
  {
    "id": "bare-name-plus-escape",
    "note": "The most common real-world spelling: bare NAME followed by ESCAPE",
    "tmpl": "[<TMPL_VAR foo ESCAPE=HTML>]",
    "params": {
      "foo": "<x>&'\""
    }
  },
  {
    "id": "bare-name-plus-default",
    "tmpl": "[<TMPL_VAR foo DEFAULT=D>]",
    "params": {}
  },
  {
    "id": "escape-before-bare-name",
    "tmpl": "[<TMPL_VAR ESCAPE=HTML foo>]",
    "params": {
      "foo": "<x>"
    }
  },
  {
    "id": "quoted-name-without-keyword",
    "tmpl": "[<TMPL_VAR \"foo\">]",
    "params": {
      "foo": "V"
    }
  },
  {
    "id": "escape-1-shorthand",
    "tmpl": "[<TMPL_VAR v ESCAPE=1>]",
    "params": {
      "v": "<x>"
    }
  },
  {
    "id": "escape-0-shorthand",
    "tmpl": "[<TMPL_VAR v ESCAPE=0>]",
    "params": {
      "v": "<x>"
    }
  },
  {
    "id": "escape-quoted-value",
    "tmpl": "[<TMPL_VAR NAME=\"v\" ESCAPE=\"html\">]",
    "params": {
      "v": "<x>"
    }
  },
  {
    "id": "name-with-spaces-around-equals",
    "tmpl": "[<TMPL_VAR NAME = v >]",
    "params": {
      "v": "V"
    }
  },
  {
    "id": "self-closing-tag",
    "tmpl": "[<TMPL_VAR NAME=foo />]",
    "params": {
      "foo": "V"
    }
  },
  {
    "id": "multiline-tag",
    "tmpl": "[<TMPL_VAR\n  NAME=\"foo\"\n>]",
    "params": {
      "foo": "V"
    }
  },
  {
    "id": "html-comment-form",
    "tmpl": "[<!-- TMPL_VAR NAME=\"foo\" -->]",
    "params": {
      "foo": "V"
    }
  },
  {
    "id": "mixed-tag-case",
    "tmpl": "<tmpl_var NAME=v><TMPL_VAR name=v>",
    "params": {
      "v": "V"
    }
  },
  {
    "id": "name-with-dot",
    "tmpl": "[<TMPL_VAR NAME=\"a.b\">]",
    "params": {
      "a.b": "V"
    }
  },
  {
    "id": "name-with-slash",
    "tmpl": "[<TMPL_VAR NAME=\"a/b\">]",
    "params": {
      "a/b": "V"
    }
  },
  {
    "id": "text-with-bare-lt",
    "tmpl": "a < b <TMPL_VAR v> c",
    "params": {
      "v": "V"
    }
  },
  {
    "id": "default-not-escaped-html",
    "note": "HTML::Template::DEF writes the default straight out, skipping the escape op",
    "tmpl": "[<TMPL_VAR NAME=foo DEFAULT='a&b' ESCAPE=HTML>]",
    "params": {}
  },
  {
    "id": "default-not-escaped-url",
    "tmpl": "[<TMPL_VAR NAME=foo DEFAULT='a b' ESCAPE=URL>]",
    "params": {}
  },
  {
    "id": "default-not-used-for-empty-string",
    "tmpl": "[<TMPL_VAR NAME=foo DEFAULT='D'>]",
    "params": {
      "foo": ""
    }
  },
  {
    "id": "default-ignored-when-value-set",
    "tmpl": "[<TMPL_VAR NAME=foo DEFAULT=\"zzz\" ESCAPE=HTML>]",
    "params": {
      "foo": "<x>"
    }
  },
  {
    "id": "default-with-single-quotes",
    "tmpl": "[<TMPL_VAR NAME=v DEFAULT=\"it's\">]",
    "params": {}
  },
  {
    "id": "default-escape-applies",
    "tmpl": "[<TMPL_VAR NAME=foo>]",
    "params": {
      "foo": "<x>"
    },
    "opts": {
      "default_escape": "HTML"
    }
  },
  {
    "id": "default-escape-suppressed-by-none",
    "note": "An explicit ESCAPE wins over default_escape, including ESCAPE=NONE and ESCAPE=0",
    "tmpl": "[<TMPL_VAR NAME=a>][<TMPL_VAR NAME=b ESCAPE=NONE>][<TMPL_VAR NAME=c ESCAPE=0>]",
    "params": {
      "a": "<x>",
      "b": "<y>",
      "c": "<z>"
    },
    "opts": {
      "default_escape": "HTML"
    }
  },
  {
    "id": "default-escape-overridden-by-url",
    "tmpl": "[<TMPL_VAR NAME=a>][<TMPL_VAR NAME=b ESCAPE=URL>]",
    "params": {
      "a": "<x>",
      "b": "a b"
    },
    "opts": {
      "default_escape": "HTML"
    }
  },
  {
    "id": "escape-html-charset",
    "tmpl": "<TMPL_VAR NAME=u ESCAPE=HTML>",
    "params": {
      "u": "<a href=\"x\">&'</a>"
    }
  },
  {
    "id": "escape-js-charset",
    "tmpl": "<TMPL_VAR NAME=u ESCAPE=JS>",
    "params": {
      "u": "it's \"x\"\nline\\end"
    }
  },
  {
    "id": "escape-url-charset",
    "tmpl": "<TMPL_VAR NAME=u ESCAPE=URL>",
    "params": {
      "u": "a~b c/d?e=f&g"
    }
  },
  {
    "id": "escape-url-reserved",
    "tmpl": "<TMPL_VAR NAME=u ESCAPE=URL>",
    "params": {
      "u": "a b+c%d-e_f.g"
    }
  },
  {
    "id": "loop-context-vars",
    "note": "Truth values differ per branch in HTML::Template::LOOP::output",
    "tmpl": "<TMPL_LOOP L>[<TMPL_VAR __counter__>/<TMPL_VAR __index__>/f=<TMPL_VAR __first__>/l=<TMPL_VAR __last__>/i=<TMPL_VAR __inner__>/o=<TMPL_VAR __outer__>/od=<TMPL_VAR __odd__>/ev=<TMPL_VAR __even__>]</TMPL_LOOP>",
    "params": {
      "L": [{}, {}, {}]
    },
    "opts": {
      "loop_context_vars": 1
    }
  },
  {
    "id": "loop-context-vars-single",
    "tmpl": "<TMPL_LOOP L>[f=<TMPL_VAR __first__>l=<TMPL_VAR __last__>i=<TMPL_VAR __inner__>o=<TMPL_VAR __outer__>]</TMPL_LOOP>",
    "params": {
      "L": [{}]
    },
    "opts": {
      "loop_context_vars": 1
    }
  },
  {
    "id": "loop-context-vars-two",
    "tmpl": "<TMPL_LOOP L>[f=<TMPL_VAR __first__>l=<TMPL_VAR __last__>i=<TMPL_VAR __inner__>o=<TMPL_VAR __outer__>]</TMPL_LOOP>",
    "params": {
      "L": [{}, {}]
    },
    "opts": {
      "loop_context_vars": 1
    }
  },
  {
    "id": "loop-context-vars-in-if",
    "tmpl": "<TMPL_LOOP L><TMPL_IF __first__>F</TMPL_IF><TMPL_IF __inner__>I</TMPL_IF><TMPL_IF __last__>L</TMPL_IF>.</TMPL_LOOP>",
    "params": {
      "L": [{}, {}, {}]
    },
    "opts": {
      "loop_context_vars": 1
    }
  },
  {
    "id": "loop-nested",
    "tmpl": "<TMPL_LOOP outer><TMPL_LOOP inner><TMPL_VAR v></TMPL_LOOP>|</TMPL_LOOP>",
    "params": {
      "outer": [
        {
          "inner": [
            {
              "v": "a"
            },
            {
              "v": "b"
            }
          ]
        },
        {
          "inner": [
            {
              "v": "c"
            }
          ]
        }
      ]
    }
  },
  {
    "id": "loop-repeated-name",
    "tmpl": "<TMPL_LOOP L>a</TMPL_LOOP><TMPL_LOOP L>b</TMPL_LOOP>",
    "params": {
      "L": [{}, {}]
    }
  },
  {
    "id": "loop-empty",
    "tmpl": "[<TMPL_LOOP L>x</TMPL_LOOP>]",
    "params": {
      "L": []
    }
  },
  {
    "id": "loop-undef-value-in-iteration",
    "tmpl": "<TMPL_LOOP L>[<TMPL_VAR a>]</TMPL_LOOP>",
    "params": {
      "L": [
        {
          "a": "x"
        },
        {
          "a": null
        }
      ]
    }
  },
  {
    "id": "loop-if-else-inside",
    "tmpl": "<TMPL_LOOP L><TMPL_IF a>Y<TMPL_ELSE>N</TMPL_IF></TMPL_LOOP>",
    "params": {
      "L": [
        {
          "a": 1
        },
        {
          "a": 0
        }
      ]
    }
  },
  {
    "id": "if-on-empty-loop",
    "tmpl": "<TMPL_IF L>yes<TMPL_ELSE>no</TMPL_IF>",
    "params": {
      "L": []
    }
  },
  {
    "id": "if-on-nonempty-loop",
    "tmpl": "<TMPL_IF L>yes<TMPL_ELSE>no</TMPL_IF><TMPL_LOOP L>x</TMPL_LOOP>",
    "params": {
      "L": [{}]
    }
  },
  {
    "id": "if-string-zero",
    "tmpl": "<TMPL_IF v>T<TMPL_ELSE>F</TMPL_IF>",
    "params": {
      "v": "0"
    }
  },
  {
    "id": "if-string-zero-point-zero",
    "tmpl": "<TMPL_IF v>T<TMPL_ELSE>F</TMPL_IF>",
    "params": {
      "v": "0.0"
    }
  },
  {
    "id": "if-string-double-zero",
    "tmpl": "<TMPL_IF v>T<TMPL_ELSE>F</TMPL_IF>",
