{
  "name": "node-perl-html-template",
  "version": "1.0.0",
  "description": "Complete TypeScript/ESM port of Perl's HTML::Template module with 100% compatibility",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "clean": "rm -rf dist coverage .vitest",
    "prepublishOnly": "yarn clean && yarn lint && yarn test && yarn build"
  },
  "keywords": [
    "template",
    "html-template",
    "perl",
    "templating",
    "html",
    "typescript",
    "esm"
  ],
  "author": "libraz <libraz@libraz.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/libraz/node-perl-html-template.git"
  },
  "bugs": {
    "url": "https://github.com/libraz/node-perl-html-template/issues"
  },
  "homepage": "https://github.com/libraz/node-perl-html-template#readme",
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/ui": "^3.2.4",
    "eslint": "~8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.4"
  },
  "resolutions": {
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1"
  },
  "volta": {
    "node": "22.20.0",
    "yarn": "4.9.1"
  }
}
