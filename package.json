{
  "name": "@libraz/html-template",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Perl HTML::Template's template syntax, with a TypeScript API",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loaders": {
      "types": "./dist/loaders/index.d.ts",
      "import": "./dist/loaders.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "import": "./dist/codegen.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "html-template-codegen": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "goldens:record": "perl scripts/record-perl-goldens.pl",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "rm -rf dist coverage .vitest",
    "check": "biome check .",
    "prepublishOnly": "yarn clean && yarn lint && yarn test && yarn build"
  },
  "keywords": [
    "template",
    "html-template",
    "perl",
    "templating",
    "html",
    "typescript",
    "esm"
  ],
  "author": "libraz <libraz@libraz.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/libraz/node-perl-html-template.git"
  },
  "bugs": {
    "url": "https://github.com/libraz/node-perl-html-template/issues"
  },
  "homepage": "https://github.com/libraz/node-perl-html-template#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "@vitest/ui": "^4.1.10",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
