{
  "name": "@libraz/html-template",
  "version": "1.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "TypeScript/ESM port of Perl's HTML::Template module core API and template syntax",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "rm -rf dist coverage .vitest",
    "check": "biome check .",
    "prepublishOnly": "yarn clean && yarn lint && yarn test && yarn build"
  },
  "keywords": [
    "template",
    "html-template",
    "perl",
    "templating",
    "html",
    "typescript",
    "esm"
  ],
  "author": "libraz <libraz@libraz.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/libraz/node-perl-html-template.git"
  },
  "bugs": {
    "url": "https://github.com/libraz/node-perl-html-template/issues"
  },
  "homepage": "https://github.com/libraz/node-perl-html-template#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.9.0",
    "@vitest/ui": "^4.1.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.6"
  },
  "volta": {
    "node": "22.20.0",
    "yarn": "4.9.1"
  }
}
